@model List<Assignment_1_Sample_Solution.Models.Event>

<h1>Event Manager</h1>

<p>Select an event to manage attendees.</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Date.ToShortDateString()</td>
                <td>@e.Location</td>

                <td>
                    <a class="btn btn-primary"
                       asp-action="ManageAttendees"
                       asp-route-id="@e.Id">
                        Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>