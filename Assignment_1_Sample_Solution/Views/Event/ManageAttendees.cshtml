@model Assignment_1_Sample_Solution.Models.Event

<h1>Manage Attendees - @Model.Title</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<hr />

<h3>Sign Up for @Model.Title</h3>

<form asp-action="SignUp" method="post">

    <input type="hidden"
           name="eventId"
           value="@Model.Id" />

    <div class="mb-3">
        <label>Name</label>

        <input class="form-control"
               name="name" />
    </div>

    <div class="mb-3">
        <label>Email</label>

        <input class="form-control"
               name="email" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Sign Up
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>

</form>

<hr />

<h3>
    Current Attendees (@Model.Attendees.Count)
</h3>

@if (Model.Attendees.Count == 0)
{
    <p>No attendees yet.</p>
}
else
{
    <ul class="list-group">

        @foreach (var attendee in Model.Attendees)
        {
            <li class="list-group-item">
                <strong>@attendee.Name</strong>
                (@attendee.Email)
            </li>
        }

    </ul>
}