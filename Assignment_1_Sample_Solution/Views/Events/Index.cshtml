@model List<Assignment_1_Sample_Solution.Models.Event>

<h1>Event Manager</h1>

<p>
    @if (User.IsInRole("Organizer"))
    {
        <a asp-action="Create" class="btn btn-primary">
            Create New Event
        </a>
    }
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Title</td>

                <td>@e.Date.ToShortDateString()</td>

                <td>@e.Location</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@e.Id">
                        Details
                    </a>
                    |

                    <a asp-action="Edit"
                       asp-route-id="@e.Id">
                        Edit
                    </a>
                    |

                    <a asp-action="Delete"
                       asp-route-id="@e.Id">
                        Delete
                    </a>
                    |

                    <a href="/events/@e.Id/attendees">
                        Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>