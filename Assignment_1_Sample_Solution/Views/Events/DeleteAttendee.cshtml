@model Assignment_1_Sample_Solution.Models.Attendee

<h1>Delete Attendee</h1>

<div class="alert alert-warning">
    <p>Are you sure you want to delete this attendee?</p>
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="DeleteAttendee" method="post">

    <input type="hidden"
           name="eventId"
           value="@Model.EventId" />

    <input type="hidden"
           name="attendeeId"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="ManageAttendees"
       asp-route-id="@Model.EventId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>